{% extends 'base.html.twig' %}

{% block title %}Erreur{% endblock %}

{% block body %}

    <div style="text-align:center; margin-top:60px;">
        <h1>Erreur lors de l'upload</h1>

        <p>
            L'envoi du fichier a échoué.
            Veuillez vérifier le format ou la taille du fichier.
        </p>

        <a href="{{ app.request.headers.get('referer') }}" class="btn btn-primary">
            Retour
        </a>
    </div>

{% endblock %}
