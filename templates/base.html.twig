<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}EduLearn{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        body { margin:0; font-family:Inter,sans-serif; background:#f1f5f9; }
        nav { background:#fff; padding:20px; display:flex; justify-content:space-between; }
        .logo { font-size:28px; font-weight:800; color:#2563eb; }
        .container { max-width:1200px; margin:auto; padding:40px; }
        a { text-decoration:none; color:#2563eb; font-weight:600; }
        footer { background:#2563eb; color:#fff; text-align:center; padding:20px; }
        ul { padding-left:20px; }
    </style>
</head>
<body>

<nav>
    <div class="logo">
        <a href="{{ path('home') }}">EduLearn</a>
    </div>

    {% if app.user %}
        <nav>
            <a href="{{ path('course_index') }}">Cours</a> |
            <a href="{{ path('quiz_index') }}">QCM</a> |
            <a href="{{ path('teacher_dashboard') }}">Espace prof</a> |
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        </nav>
    {% else %}
        <nav>
            <a href="{{ path('app_login') }}">Connexion</a>
        </nav>
    {% endif %}

</nav>

<div class="container">
    {% block body %}{% endblock %}
</div>

<footer>
    EduLearn – Frontend Twig statique
</footer>

</body>
</html>
