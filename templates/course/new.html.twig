{% extends 'base.html.twig' %}
{% block title %}Ajouter un contenu{% endblock %}

{% block body %}
    <h1>Ajouter un contenu pédagogique</h1>

    <p>Veuillez choisir le type de contenu à ajouter :</p>

    <hr>

    <h2>Ajouter une vidéo</h2>

    <form method="post"
          enctype="multipart/form-data"
          action="{{ path('video_new') }}">

        <label>Titre de la vidéo</label><br>
        <input type="text" name="title" required><br><br>

        <label>Fichier vidéo (MP4)</label><br>
        <input type="file" name="video" accept="video/mp4" required><br><br>

        <button>Uploader la vidéo</button>
    </form>

    <hr>

    <h2>Ajouter un document</h2>

    <form method="post"
          enctype="multipart/form-data"
          action="{{ path('document_new') }}">

        <label>Titre du document</label><br>
        <input type="text" name="title" required><br><br>

        <label>Fichier document (PDF)</label><br>
        <input type="file" name="document" accept="application/pdf" required><br><br>

        <button>Uploader le document</button>
    </form>

{% endblock %}
