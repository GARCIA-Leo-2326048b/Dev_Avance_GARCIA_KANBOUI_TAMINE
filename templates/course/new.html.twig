{% extends 'base.html.twig' %}
{% block title %}Ajouter un contenu{% endblock %}

{% block body %}
    <h1>Ajouter un contenu pédagogique</h1>
    <p class="page-subtitle">
        Choisissez le type de contenu que vous souhaitez mettre à disposition.
    </p>

    <div class="content-add-grid">

        <div class="content-add-card">
            <div class="content-add-icon video-icon">🎥</div>

            <h3>Ajouter une vidéo</h3>
            <p>
                Importez une vidéo de cours au format MP4.
            </p>

            <form method="post"
                  enctype="multipart/form-data"
                  action="{{ path('video_new') }}">

                <label>Titre de la vidéo</label>
                <input type="text" name="title" required>

                <label>Fichier vidéo (MP4)</label>
                <input type="file" name="video" accept="video/mp4" required>

                <button class="btn btn-primary">Uploader la vidéo</button>
            </form>
        </div>

        <div class="content-add-card">
            <div class="content-add-icon document-icon">📄</div>

            <h3>Ajouter un document</h3>
            <p>
                Importez un document pédagogique au format PDF.
            </p>

            <form method="post"
                  enctype="multipart/form-data"
                  action="{{ path('document_new') }}">

                <label>Titre du document</label>
                <input type="text" name="title" required>

                <label>Fichier document (PDF)</label>
                <input type="file" name="document" accept="application/pdf" required>

                <button class="btn btn-secondary">Uploader le document</button>
            </form>
        </div>

    </div>
{% endblock %}
