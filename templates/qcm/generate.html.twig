{% extends 'base.html.twig' %}

{% block title %}{{ qcm.title }}{% endblock %}

{% block body %}

    <h1>{{ qcm.title }}</h1>
    <p>{{ qcm.description }}</p>

    <form method="post" action="{{ path('quizz_attempt_result') }}">
        <input type="hidden" name="qcm_id" value="{{ qcm.id }}">

        {% for question in qcm.questions %}

            <div class="question-block">
                <h3>{{ loop.index }}. {{ question.question }}</h3>

                {% for response in question.responses %}
                    <div>
                        <input type="radio"
                               name="answers[{{ question.id }}]"
                               value="{{ response.id }}"
                               required>

                        <label>{{ response.label }}</label>
                    </div>
                {% endfor %}

            </div>

            <hr>

        {% endfor %}


        <button type="submit" class="btn btn-primary">
            Valider le QCM
        </button>

    </form>

{% endblock %}
