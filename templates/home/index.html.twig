{% extends 'base.html.twig' %}

{% block title %}Accueil – EduLearn{% endblock %}

{% block body %}

    <section style="
    background: linear-gradient(135deg, #2563eb, #0891b2);
    color: white;
    padding: 80px 20px;
    text-align: center;
">
        <h1 style="font-size:48px;font-weight:800;margin-bottom:20px;">
            Plateforme d’Apprentissage Moderne
        </h1>
        <p style="font-size:20px;opacity:0.9;max-width:600px;margin:auto;">
            Accédez à vos cours, vidéos, documents et QCM générés par IA
        </p>

        <div style="display:flex;justify-content:center;gap:40px;margin-top:40px;flex-wrap:wrap;">
            <div>
                <div style="font-size:36px;font-weight:800;">150+</div>
                <div>Cours</div>
            </div>
            <div>
                <div style="font-size:36px;font-weight:800;">2500+</div>
                <div>Étudiants</div>
            </div>
            <div>
                <div style="font-size:36px;font-weight:800;">98%</div>
                <div>Satisfaction</div>
            </div>
        </div>
    </section>

    <div class="container">

        <h2 style="font-size:32px;font-weight:800;margin-bottom:20px;">
            Vidéos de cours
        </h2>

        <div style="display:flex;gap:20px;overflow-x:auto;">
            {% for i in 1..4 %}
                <div style="
                min-width:280px;
                background:white;
                border-radius:12px;
                padding:20px;
                box-shadow:0 4px 20px rgba(0,0,0,0.1);
            ">
                    <div style="
                    height:160px;
                    background:linear-gradient(135deg,#667eea,#764ba2);
                    border-radius:8px;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:48px;
                    color:white;
                ">▶</div>

                    <h3 style="margin:15px 0 5px 0;">Cours Symfony {{ i }}</h3>
                    <p style="font-size:14px;color:#64748b;">Professeur • 45 min</p>

                    <button class="btn btn-primary" style="margin-top:10px;width:100%;">
                        Passer le QCM
                    </button>
                </div>
            {% endfor %}
        </div>

        <h2 style="font-size:32px;font-weight:800;margin:40px 0 20px;">
            Documents pédagogiques
        </h2>

        <ul>
            {% for i in 1..5 %}
                <li style="margin-bottom:10px;">
                    📄 Document {{ i }} – Support de cours PDF
                </li>
            {% endfor %}
        </ul>

    </div>

{% endblock %}
